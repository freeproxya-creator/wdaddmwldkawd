local function findHighestValueFruit()
    if not Gardens then return nil end
    local best = nil
    for _, plot in Gardens:GetChildren() do
        local plants = plot:FindFirstChild("Plants")
        if not plants then continue end
        local ownerName = getPlotOwnerName(plot)
        for _, plant in plants:GetChildren() do
            local fruitsFolder = plant:FindFirstChild("Fruits")
            local scanList = fruitsFolder and fruitsFolder:GetChildren() or { plant }
            for _, fruit in scanList do
                if not fruit or not fruit.Parent then continue end
                local value = calculateFruitValue(fruit)
                if value <= 0 then continue end
                local fruitName = getFruitStealName(fruit)
                if not best or value > best.value then
                    best = {
                        value = value,
                        fruitName = fruitName,
                        displayName = getFruitDisplayName(fruitName),
                        ownerName = ownerName,
                    }
                end
            end
        end
    end
    return best
end

