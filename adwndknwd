local function petDisplayName(species, size)
    if not species then return "Unknown" end
    if PetData then
        local ok, n = pcall(PetData.GetDisplayName, species, size)
        if ok and type(n) == "string" then return n end
        ok, n = pcall(PetData.GetSpeciesDisplayName, species)
        if ok and type(n) == "string" then return n end
    end
    return species
end

local function petRarity(species)
    local d = PetBySpecies[species]
    return (d and d.Rarity) or "Common"
end

local function resolveRef(model)
    if not model or not WildPetRef then return nil end
    local refName = model.Name:match("^WildPet_.-_(.+)$")
    local ref = refName and WildPetRef:FindFirstChild(refName)
    if ref and ref:IsA("BasePart") then return ref end
    for _, ch in WildPetRef:GetChildren() do
        if ch:IsA("BasePart") and model.Name:find(ch.Name, 1, true) then return ch end
    end
    return nil
end

local function collectPets()
    initMap()
    local seen, list = {}, {}
    local function add(ref, model)
        if not ref then return end
        local species = ref:GetAttribute("PetName") or (model and model:GetAttribute("PetName"))
        if not species then return end
        local key = ref:GetFullName()
        if seen[key] then return end
        seen[key] = true
        local size = ref:GetAttribute("PetSize") or (model and model:GetAttribute("PetSize"))
        list[#list + 1] = {
            species = species,
            display = petDisplayName(species, size),
            rarity = petRarity(species),
            price = ref:GetAttribute("Price") or (model and model:GetAttribute("Price")) or 0,
            key = key,
        }
    end
    if WildPetRef then
        for _, ref in WildPetRef:GetChildren() do
            if ref:IsA("BasePart") then add(ref, nil) end
        end
    end
    if WildPetSpawns then
        for _, model in WildPetSpawns:GetChildren() do
            if model:IsA("Model") then add(resolveRef(model), model) end
        end
    end
    return list
end

local function fruitSeedName(fruit)
    if not fruit then return nil end
    return fruit:GetAttribute("CorePartName")
        or fruit:GetAttribute("PlantName")
        or fruit:GetAttribute("FruitName")
        or fruit:GetAttribute("SeedName")
        or fruit.Name
end

local function fruitDisplayName(seedName)
    local info = seedName and SeedByName[seedName]
    if info then
        if type(info.DisplayName) == "string" and info.DisplayName ~= "" then return info.DisplayName end
        if type(info.SeedDisplayName) == "string" and info.SeedDisplayName ~= "" then return info.SeedDisplayName end
    end
    return seedName or "Unknown"
end

local function fruitValue(fruit)
    if not fruit or not FruitValueCalc then return 0 end
    local name = fruitSeedName(fruit)
    if not name then return 0 end
    local ok, val = pcall(FruitValueCalc, name,
        fruit:GetAttribute("SizeMulti") or fruit:GetAttribute("Age"),
        fruit:GetAttribute("Mutation"), LP, 1)
    return ok and (tonumber(val) or 0) or 0
end

local function plotOwner(plot)
    if not plot then return "Unknown" end
    local owner = plot:GetAttribute("Owner")
    if type(owner) == "string" and owner ~= "" then return owner end
    local uid = plot:GetAttribute("OwnerUserId")
    if uid then
        local plr = S.Players:GetPlayerByUserId(tonumber(uid) or uid)
        if plr then return plr.Name end
    end
    return "Unknown"
end

local function findBestFruit()
    if not Gardens then return nil end
    local best
    for _, plot in Gardens:GetChildren() do
        local plants = plot:FindFirstChild("Plants")
        if not plants then continue end
        local owner = plotOwner(plot)
        for _, plant in plants:GetChildren() do
            local fruits = plant:FindFirstChild("Fruits")
            local scan = fruits and fruits:GetChildren() or { plant }
            for _, fruit in scan do
                if not fruit or not fruit.Parent then continue end
                local val = fruitValue(fruit)
                if val <= 0 then continue end
                local seed = fruitSeedName(fruit)
                if not best or val > best.value then
                    best = {
                        value = val,
                        seed = seed,
                        display = fruitDisplayName(seed),
                        owner = owner,
                    }
                end
            end
        end
    end
    return best
end

