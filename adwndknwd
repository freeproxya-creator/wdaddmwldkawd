local function toWikiTitle(key)
    if type(key) ~= "string" or key == "" then return nil end
    if WIKI_OVERRIDES[key] then return WIKI_OVERRIDES[key] end
    return key:gsub("(%l)(%u)", "%1_%2")
end

local function parseWikiImage(body)
    if type(body) ~= "string" then return nil end
    local ok, data = pcall(function() return S.HS:JSONDecode(body) end)
    if ok and type(data) == "table" and type(data.items) == "table" then
        for _, item in pairs(data.items) do
            local src = item.thumbnail and item.thumbnail.source
                or item.originalimage and item.originalimage.source
            if type(src) == "string" and src:find("^https://") then return src end
        end
    end
    local og = body:match('<meta property="og:image" content="([^"]+)"')
        or body:match('<meta content="([^"]+)" property="og:image"')
    if og and og:find("^https://") then return og end
    return body:match("(https://static%.wikia%.nocookie%.net/growagarden2/images/[%w%-_%.%%/]+%.%a+)")
end

local function parseAssetId(v)
    if type(v) == "number" then return v end
    if type(v) ~= "string" then return nil end
    local id = v:match("rbxassetid://(%d+)") or (v:match("^%d+$") and v)
    return id and tonumber(id) or nil
end

local function getRobloxThumbUrl(assetId)
    assetId = parseAssetId(assetId)
    if not assetId then return nil end
    local ck = "rbx:" .. assetId
    if wikiImgCache[ck] ~= nil then
        return wikiImgCache[ck] ~= false and wikiImgCache[ck] or nil
    end
    local api = "https://thumbnails.roblox.com/v1/assets?assetIds="
        .. assetId .. "&size=420x420&format=Png&isCircular=false"
    local body = httpGet(api)
    if body then
        local ok, data = pcall(function() return S.HS:JSONDecode(body) end)
        if ok and data and data.data and data.data[1] and data.data[1].imageUrl then
            wikiImgCache[ck] = data.data[1].imageUrl
            return wikiImgCache[ck]
        end
    end
    wikiImgCache[ck] = false
    return nil
end

local function getGameImage(key)
    if type(key) ~= "string" or key == "" then return nil end
    local seed = SeedByName[key]
    if seed then
        for _, k in ipairs({ "Icon", "Image", "ImageId", "CropImage", "Thumbnail" }) do
            local url = getRobloxThumbUrl(seed[k])
            if url then return url end
        end
    end
    local pet = PetBySpecies[key]
    if pet then
        for _, k in ipairs({ "Icon", "Image", "ImageId", "IconImage", "Thumbnail", "RenderImage" }) do
            local url = getRobloxThumbUrl(pet[k])
            if url then return url end
        end
    end
    if PetData and type(PetData.GetIcon) == "function" then
        local ok, icon = pcall(PetData.GetIcon, key)
        local url = ok and getRobloxThumbUrl(icon)
        if url then return url end
    end
    return nil
end

local function getWikiImage(key)
    if type(key) ~= "string" or key == "" then return nil end
    if wikiImgCache[key] ~= nil then
        return wikiImgCache[key] ~= false and wikiImgCache[key] or nil
    end
    local title = toWikiTitle(key)
    if not title then return nil end
    local url = "https://growagarden2.fandom.com/api/v1/Article?titles=" .. S.HS:UrlEncode(title)
    local img = parseWikiImage(httpGet(url))
    if not img then
        img = parseWikiImage(httpGet("https://growagarden2.fandom.com/wiki/" .. title))
    end
    wikiImgCache[key] = img or false
    return img
end

local function getItemImage(key)
    if type(key) ~= "string" or key == "" then return nil end
    local ck = "img:" .. key
    if wikiImgCache[ck] ~= nil then
        return wikiImgCache[ck] ~= false and wikiImgCache[ck] or nil
    end
    local img = getGameImage(key) or getWikiImage(key)
    wikiImgCache[ck] = img or false
    return img
end

local function getCachedImage(key)
    if type(key) ~= "string" or key == "" then return nil end
    local ck = "img:" .. key
    local v = wikiImgCache[ck]
    if v and v ~= false then return v end
    return nil
end

local function fetchImageAsync(key)
