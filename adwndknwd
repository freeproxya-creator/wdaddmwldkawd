local function fruitValue(fruit, plot)
    if not fruit or not FruitValueCalc then return 0 end
    local name = fruitSeedName(fruit)
    if not name then return 0 end
    local calcPlr = LP
    if plot then
        local uid = plot:GetAttribute("OwnerUserId")
        if uid then
            local plr = S.Players:GetPlayerByUserId(tonumber(uid) or uid)
            if plr then calcPlr = plr end
        end
    end
    local ok, val = pcall(FruitValueCalc, name,
        fruit:GetAttribute("SizeMulti") or fruit:GetAttribute("Age"),
        fruit:GetAttribute("Mutation"), calcPlr, 1)
    return ok and (tonumber(val) or 0) or 0
end

local ownerNameCache = {}

local function plotOwner(plot)
    if not plot then return "Unknown" end
    local owner = plot:GetAttribute("Owner")
    if type(owner) == "string" and owner ~= "" then return owner end
    local uid = plot:GetAttribute("OwnerUserId")
    local nuid = uid and tonumber(uid)
    if nuid and nuid > 0 then
        if ownerNameCache[nuid] then return ownerNameCache[nuid] end
        local plr = S.Players:GetPlayerByUserId(nuid)
        if plr then
            ownerNameCache[nuid] = plr.Name
            return plr.Name
        end
        local ok, name = pcall(S.Players.GetNameFromUserIdAsync, S.Players, nuid)
        if ok and type(name) == "string" and name ~= "" then
            ownerNameCache[nuid] = name
            return name
        end
        ownerNameCache[nuid] = "User_" .. tostring(nuid)
        return ownerNameCache[nuid]
    end
    return "Unknown"
end

local function iterPlotFruits(plot)
    local out = {}
    local plants = plot:FindFirstChild("Plants")
    if not plants then return out end
    for _, plant in plants:GetChildren() do
        local fruits = plant:FindFirstChild("Fruits")
        if fruits then
            for _, fruit in fruits:GetChildren() do
                if fruit and fruit.Parent then out[#out + 1] = fruit end
            end
        else
            if plant:GetAttribute("CorePartName") or plant:GetAttribute("PlantName")
                or plant:GetAttribute("FruitName") or plant:FindFirstChildWhichIsA("BasePart", true) then
                out[#out + 1] = plant
            end
        end
    end
    return out
end

local function findBestFruit()
    if not Gardens then return nil end
    local best
    local plotsScanned, fruitsChecked = 0, 0
    safeRun("findBestFruit", function()
        for _, plot in Gardens:GetChildren() do
            local fruits = iterPlotFruits(plot)
            if #fruits == 0 then continue end
            plotsScanned += 1
            local owner = plotOwner(plot)
            for _, fruit in ipairs(fruits) do
                fruitsChecked += 1
                local ok, val = pcall(fruitValue, fruit, plot)
                val = ok and (tonumber(val) or 0) or 0
                if val <= 0 then continue end
                local seed = fruitSeedName(fruit)
                if not best or val > best.value then
                    best = {
                        value = val,
                        seed = seed,
                        display = fruitDisplayName(seed),
                        owner = owner,
                        plotName = plot.Name,
                    }
                end
            end
        end
    end)
    if best then
        best.plotsScanned = plotsScanned
        best.fruitsChecked = fruitsChecked
    end
    return best
end

