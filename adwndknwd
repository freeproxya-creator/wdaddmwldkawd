local function safeNetCall(remote, ...)
    if not remote then return false end
    local args = { ... }
    if type(remote.Fire) == "function" then
        return pcall(function() remote:Fire(table.unpack(args)) end)
    end
    if type(remote.FireServer) == "function" then
        return pcall(function() remote:FireServer(table.unpack(args)) end)
    end
    if type(remote.InvokeServer) == "function" then
        return pcall(function() return remote:InvokeServer(table.unpack(args)) end)
    end
    if type(remote.Invoke) == "function" then
        return pcall(function() return remote:Invoke(table.unpack(args)) end)
    end
    return false
end

