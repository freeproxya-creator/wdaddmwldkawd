local function fmtNum(n)
    n = math.floor(tonumber(n) or 0)
    if n >= 1e9 then
        local v = math.floor(n / 1e9 * 10 + 0.5) / 10
        return v == math.floor(v) and (math.floor(v) .. "b") or (v .. "gb")
    end
    if n >= 1e6 then
        local v = math.floor(n / 1e6 * 10 + 0.5) / 10
        return v == math.floor(v) and (math.floor(v) .. "m") or (v .. "gm")
    end
    if n >= 1e3 then
        local v = math.floor(n / 1e3 * 10 + 0.5) / 10
        return v == math.floor(v) and (math.floor(v) .. "k") or (v .. "gk")
    end
    return tostring(n)
end

local function sendDiscord(webhookUrl, desc, color, thumbKey)
    if type(webhookUrl) ~= "string" or webhookUrl == "" then return false end
    local embed = {
        description = desc,
        color = color or 0xFF4FD8,
        footer = { text = footerText() },
    }
    local img = thumbKey and getWikiImage(thumbKey)
    if type(img) == "string" and img:find("^https://") and not img:find("roblox%.com") then
        embed.thumbnail = { url = img }
    end

    local function post(data)
        local ok, json = pcall(function()
            return S.HS:JSONEncode({ username = "NTMT HUB", embeds = { data } })
        end)
        return ok and httpPost(webhookUrl, json)
    end

    if post(embed) then return true end
    if embed.thumbnail then
        embed.thumbnail = nil
        if post(embed) then return true end
    end
    local ok, json = pcall(function()
        return S.HS:JSONEncode({ username = "NTMT HUB", content = desc })
    end)
    return ok and httpPost(webhookUrl, json)
end

