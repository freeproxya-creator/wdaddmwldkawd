    if type(ownerName) == "string" and ownerName ~= "" then return ownerName end
    local ownerId = plot:GetAttribute("OwnerUserId")
    if ownerId ~= nil then
        local uid = tonumber(ownerId) or ownerId
        local plr = Services.Players:GetPlayerByUserId(uid)
