local function embedToText(embed)
    local lines = {}
    if type(embed.description) == "string" and embed.description ~= "" then
        lines[#lines + 1] = embed.description
    end
    if type(embed.fields) == "table" then
        for _, f in ipairs(embed.fields) do
            if f.name and f.value and f.value ~= "-" then
                lines[#lines + 1] = f.name .. " " .. f.value
            elseif f.name then
                lines[#lines + 1] = f.name
            end
        end
    end
    return table.concat(lines, "\n")
end

local function sendDiscord(webhookUrl, embed)
    if type(webhookUrl) ~= "string" or webhookUrl == "" then return false end
    embed.color = embed.color or 0xFF4FD8
    embed.footer = embed.footer or { text = footerText() }

    local function post(data)
        local ok, json = pcall(function()
            return S.HS:JSONEncode({ username = "NTMT HUB", embeds = { data } })
        end)
        if not ok or type(json) ~= "string" then return false end
        return httpPost(webhookUrl, json)
    end

    local plain = embedToText(embed)

    if post(embed) then return true end
    if embed.thumbnail then
        embed.thumbnail = nil
        if post(embed) then return true end
    end
    local noFields = {
        description = plain,
        color = embed.color,
        footer = embed.footer,
    }
    if post(noFields) then return true end
    if plain ~= "" then
        local ok, json = pcall(function()
            return S.HS:JSONEncode({ username = "NTMT HUB", content = plain })
        end)
        return ok and httpPost(webhookUrl, json)
    end
    return false
end

