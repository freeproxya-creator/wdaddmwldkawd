local function resetIfNewServer()
    local j = tostring(game.JobId)
    if j ~= currentJob then
        table.clear(sentThisServer)
        currentJob = j
    end
end

local function alreadySent(key)
    return sentThisServer[key] == true
end

local function markSent(key)
    sentThisServer[key] = true
end

local function fruitSentForJob(jobId)
    pruneFruitSentCache()
    jobId = tostring(jobId or "")
    if jobId == "" then return false end
    if sentThisServer[jobId .. "|fruit|"] then return true end
    local ts = genv.ntmt_fruit_sent[jobId]
    return type(ts) == "number" and os.time() - ts < REJOIN_COOLDOWN
end

local function markFruitSent(jobId)
    jobId = tostring(jobId or "")
    if jobId == "" then return end
    sentThisServer[jobId .. "|fruit|"] = true
    genv.ntmt_fruit_sent[jobId] = os.time()
end

local function notifyPet(pet)
    local key = currentJob .. "|pet|" .. pet.key
    if alreadySent(key) then return false end
    local jl = jobLine()
    local embed = attachImage({
        description = table.concat({
            "** " .. pet.rarity .. " pet has spawn **",
            pet.display,
            fmtNum(pet.price) .. " sheckles",
        }, "\n"),
        color = RARITY_COLOR[pet.rarity] or 0xFF4FD8,
        fields = {
            { name = "pc copy:", value = "```" .. jl .. "```", inline = true },
            { name = "mobile copy:", value = "`" .. jl .. "`", inline = true },
        },
    }, pet.species)
    local ok = sendDiscord(PET_WEBHOOK, embed)
    if not ok then warn("[NTMT HUB] pet webhook fail:", pet.display) end
    if ok then markSent(key) end
    return ok
end

local function notifyFruit(best)
    if not best or best.value <= 0 then return false end
    if fruitSentForJob(currentJob) then return false end

    local jl = jobLine()
    local desc = table.concat({
        "** FRUIT HIGHEST VALUE FOR U TO STEAL **",
        "name fruit: " .. best.display,
        "value of fruit: " .. fmtNum(best.value),
        "garden owner username: " .. best.owner,
        "pc copy:",
        "```" .. jl .. "```",
        "mobile copy:",
        "`" .. jl .. "`",
    }, "\n")

    local embed = attachImage({
        description = desc,
        color = 0x22C55E,
    }, best.seed)

    local ok = sendDiscord(FRUIT_WEBHOOK, embed)
    if not ok then warn("[NTMT HUB] fruit webhook fail:", best.display) end
    if ok then markFruitSent(currentJob) end
    return ok
end

local function scanOnce()
    resetIfNewServer()
    initMap()
    task.wait(MAP_WAIT)

    local pets = collectPets()

    syncServerGardens()
    local plotsBefore = countGardenPlotsWithPlants()
    if plotsBefore <= 1 then
        task.wait(1.5)
        syncServerGardens()
    end
    local best = findBestFruit()

    for _, pet in ipairs(pets) do fetchImageAsync(pet.species) end
    if best and best.seed then fetchImageAsync(best.seed) end

    local petOk = 0
    for _, pet in ipairs(pets) do
        if notifyPet(pet) then petOk += 1 end
        task.wait(WEBHOOK_GAP)
    end

    local fruitOk = notifyFruit(best)

    local fruitInfo = best
        and (best.display .. " " .. fmtNum(best.value) .. " @" .. best.owner
            .. " | gardens:" .. tostring(best.plotsScanned or "?") .. " fruits:" .. tostring(best.fruitsChecked or "?"))
        or "none"
    print("[NTMT HUB] scan | pets:", #pets, "sent:", petOk, "| fruit:", fruitInfo, "sent:", fruitOk and "yes" or "no")
    return petOk, #pets, fruitOk, best
end

-- ===== HOP =====
local visited = {}
if type(genv.ntmt_owner_visited) == "table" then
    for id, ts in genv.ntmt_owner_visited do
        if type(id) == "string" and type(ts) == "number" then visited[id] = ts end
    end
end

local function saveVisited()
    genv.ntmt_owner_visited = visited
end

local function markVisited(id)
    id = tostring(id or "")
    if id ~= "" then
        visited[id] = os.time()
        local now = os.time()
        local count = 0
        for jid, ts in visited do
            count += 1
            if count > 200 or (now - ts) > 3600 then visited[jid] = nil end
        end
        saveVisited()
    end
end

markVisited(game.JobId)

local function canHopTo(id)
    id = tostring(id)
    if id == "" or id == tostring(game.JobId) then return false end
    local ts = visited[id]
    return not ts or (os.time() - ts) >= REJOIN_COOLDOWN
end

local function hopServer()
    if hoppingBusy then return false end
    if os.clock() - lastHopAt < HOP_COOLDOWN then return false end

    local job = tostring(game.JobId)
    local picks = {}
    local cursor = nil

    for _ = 1, 3 do
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId
            .. "/servers/Public?sortOrder=Desc&limit=100"
        if cursor and cursor ~= "" then
            url = url .. "&cursor=" .. S.HS:UrlEncode(cursor)
        end
        local body = httpGet(url)
        if not body then break end
        local ok, page = pcall(function() return S.HS:JSONDecode(body) end)
        if not ok or not page or not page.data then break end

        for _, s in page.data do
            local id = tostring(s.id or "")
            if id ~= "" and id ~= job and canHopTo(id) then
                local playing = tonumber(s.playing) or 0
                local maxP = tonumber(s.maxPlayers) or 50
                if playing > MIN_PLAYERS and playing < maxP then
                    picks[#picks + 1] = id
                end
            end
        end

        cursor = page.nextPageCursor
        if #picks >= 20 or type(cursor) ~= "string" or cursor == "" then break end
        task.wait(0.15)
    end

    if #picks == 0 then
        warn("[NTMT HUB] no server with >", MIN_PLAYERS, "players")
        return false
    end

    local target = picks[math.random(1, #picks)]
    markVisited(target)
    hoppingBusy = true
    lastHopAt = os.clock()

    local teleOk = pcall(function()
        S.TS:TeleportToPlaceInstance(game.PlaceId, target, LP)
    end)
    if not teleOk then
        hoppingBusy = false
        return false
    end

    task.delay(12, function()
        hoppingBusy = false
    end)
    return true
end

