local function parseAssetId(value)
    if type(value) == "number" then return value end
    if type(value) ~= "string" then return nil end
    local fromAsset = value:match("rbxassetid://(%d+)")
    if fromAsset then return tonumber(fromAsset) end
    if value:match("^%d+$") then return tonumber(value) end
    return nil
end

local function assetIdToThumbUrl(assetId)
    assetId = parseAssetId(assetId)
    if not assetId then return nil end
    local cacheKey = tostring(assetId)
    if thumbCache[cacheKey] then return thumbCache[cacheKey] end

    local api = "https://thumbnails.roblox.com/v1/assets?assetIds="
        .. assetId .. "&size=420x420&format=Png&isCircular=false"
    local body = universalHttpGet(api)
    if body then
        local ok, data = xpcall(function() return Services.HttpService:JSONDecode(body) end, noopErr)
        if ok and data and data.data and data.data[1] and data.data[1].imageUrl then
            thumbCache[cacheKey] = data.data[1].imageUrl
            return thumbCache[cacheKey]
        end
    end

    local fallback = "https://www.roblox.com/asset-thumbnail/image?assetId="
        .. assetId .. "&width=420&height=420&format=png"
    thumbCache[cacheKey] = fallback
    return fallback
end

local function getPetImageUrl(species, model)
    local d = PetDataBySpecies[species]
    if d then
        for _, key in ipairs({ "Icon", "Image", "ImageId", "IconImage", "Thumbnail", "ThumbnailId", "RenderImage", "PetIcon" }) do
            local url = assetIdToThumbUrl(d[key])
            if url then return url end
        end
    end
    if PetData and type(PetData.GetIcon) == "function" then
        local ok, icon = xpcall(PetData.GetIcon, noopErr, species)
        local url = assetIdToThumbUrl(icon)
        if url then return url end
    end
    if model then
        for _, desc in model:GetDescendants() do
            if desc:IsA("Decal") or desc:IsA("Texture") then
                local url = assetIdToThumbUrl(desc.Texture)
                if url then return url end
            end
            if desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
                local url = assetIdToThumbUrl(desc.Image)
                if url then return url end
            end
        end
    end
    return nil
end

