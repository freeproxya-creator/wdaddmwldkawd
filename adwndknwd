local wikiImgCache = {}

local WIKI_OVERRIDES = {
    GreenBean = "Green_Bean", DragonFruit = "Dragon_Fruit", VenusFlyTrap = "Venus_Fly_Trap",
    PoisonApple = "Poison_Apple", VenomSpitter = "Venom_Spitter", MoonBloom = "Moon_Bloom",
    HypnoBloom = "Hypno_Bloom", DragonsBreath = "Dragon's_Breath", DragonBreath = "Dragon's_Breath",
    BabyCactus = "Baby_Cactus", HornedMelon = "Horned_Melon", GlowMushroom = "Glow_Mushroom",
    PoisonIvy = "Poison_Ivy", GhostPepper = "Ghost_Pepper", BriarRose = "Briar_Rose",
    FireDragon = "Fire_Dragon", IceDragon = "Ice_Dragon", GoldenDragon = "Golden_Dragon",
    RainbowButterfly = "Rainbow_Butterfly", HoneyBee = "Honey_Bee", PolarBear = "Polar_Bear",
}

local function toWikiTitle(key)
    if type(key) ~= "string" or key == "" then return nil end
    if WIKI_OVERRIDES[key] then return WIKI_OVERRIDES[key] end
    return key:gsub("(%l)(%u)", "%1_%2")
end

local function parseWikiImage(body)
    if type(body) ~= "string" then return nil end
    local ok, data = pcall(function() return S.HS:JSONDecode(body) end)
    if ok and type(data) == "table" and type(data.items) == "table" then
        for _, item in pairs(data.items) do
            local src = item.thumbnail and item.thumbnail.source
                or item.originalimage and item.originalimage.source
            if type(src) == "string" and src:find("^https://") then return src end
        end
    end
    local og = body:match('<meta property="og:image" content="([^"]+)"')
        or body:match('<meta content="([^"]+)" property="og:image"')
    if og and og:find("^https://") then return og end
    return body:match("(https://static%.wikia%.nocookie%.net/growagarden2/images/[%w%-_%.%%/]+%.%a+)")
end

local function getWikiImage(key)
    if type(key) ~= "string" or key == "" then return nil end
    if wikiImgCache[key] ~= nil then
        return wikiImgCache[key] ~= false and wikiImgCache[key] or nil
    end
    local title = toWikiTitle(key)
    if not title then return nil end
    local url = "https://growagarden2.fandom.com/api/v1/Article?titles=" .. S.HS:UrlEncode(title)
    local img = parseWikiImage(httpGet(url))
    if not img then
        img = parseWikiImage(httpGet("https://growagarden2.fandom.com/wiki/" .. title))
    end
    wikiImgCache[key] = img or false
    return img
end

