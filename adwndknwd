local function fmtNum(n)
    n = math.floor(tonumber(n) or 0)
    if n >= 1e9 then
        local v = math.floor(n / 1e9 * 10 + 0.5) / 10
        return (v == math.floor(v) and tostring(math.floor(v)) or tostring(v)) .. "bn"
    end
    if n >= 1e6 then
        local v = math.floor(n / 1e6 * 10 + 0.5) / 10
        return (v == math.floor(v) and tostring(math.floor(v)) or tostring(v)) .. "m"
    end
    if n >= 1e3 then
        local v = math.floor(n / 1e3 * 10 + 0.5) / 10
        return (v == math.floor(v) and tostring(math.floor(v)) or tostring(v)) .. "k"
    end
    return tostring(n)
end

